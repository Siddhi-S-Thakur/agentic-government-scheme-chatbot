# Application Environment
APP_ENV=development
DEBUG_RETRIEVAL=true
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gov_scheme_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=gov_schemes

# Embeddings & Reranking Models
# Multilingual embedding model supporting English, Hindi, and Marathi
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Configurable reranker model (BGE or Cross-Encoder)
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# LLM Configuration (Configurable: 'gemini' or 'openai')
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
